# Runs the FPL Stato FastAPI application as a local backend for Nginx.
[Unit]
Description=FPL Stato FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/fpl-stato
EnvironmentFile=-/etc/fpl-stato.env
ExecStart=/home/ubuntu/projects/fpl-stato/.venv/bin/uvicorn fpl_stato.api:app --host 172.26.5.252 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
